{
  "info": {
    "name": "CampusCare Backend API",
    "description": "Postman collection for all CampusCare REST APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "departmentAdminToken", "value": "" },
    { "key": "departmentId", "value": "1" },
    { "key": "workerId", "value": "1" },
    { "key": "complaintId", "value": "1" },
    { "key": "notificationId", "value": "1" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collegeEmail\": \"admin@college.edu\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collegeEmail\": \"student@college.edu\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('studentToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plumbing\",\n  \"code\": \"PLUMBING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/departments",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "departments"]
            }
          }
        },
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/departments",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "departments"]
            }
          }
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plumbing Services\",\n  \"code\": \"PLUMBING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "departments", "{{departmentId}}"]
            }
          }
        },
        {
          "name": "Disable Department",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "departments", "{{departmentId}}"]
            }
          }
        },
        {
          "name": "Create Department Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Facilities Admin\",\n  \"collegeEmail\": \"facilities-admin@college.edu\",\n  \"password\": \"password123\",\n  \"departmentIds\": [1]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/department-admins",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "department-admins"]
            }
          }
        },
        {
          "name": "Create Worker",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maintenance Worker\",\n  \"collegeEmail\": \"worker@college.edu\",\n  \"password\": \"password123\",\n  \"departmentIds\": [1]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/workers",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "workers"]
            }
          }
        },
        {
          "name": "List Workers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/workers",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "workers"]
            }
          }
        },
        {
          "name": "Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "analytics"]
            }
          }
        }
      ]
    },
    {
      "name": "Student Complaints",
      "item": [
        {
          "name": "Create Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Water leakage\",\n  \"description\": \"Water is leaking from a pipe near the library entrance.\",\n  \"additionalInformation\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/student/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["student", "complaints"]
            }
          }
        },
        {
          "name": "List My Complaints",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/student/complaints?status=RESOLVED&search=water&page=0&size=20&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["student", "complaints"],
              "query": [
                { "key": "status", "value": "RESOLVED" },
                { "key": "search", "value": "water" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "Complaint Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/student/complaints/{{complaintId}}",
              "host": ["{{baseUrl}}"],
              "path": ["student", "complaints", "{{complaintId}}"]
            }
          }
        },
        {
          "name": "Complaint History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/student/complaints/{{complaintId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["student", "complaints", "{{complaintId}}", "history"]
            }
          }
        },
        {
          "name": "Answer AI Follow-up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalInformation\": \"The leak is beside the library entrance and affects the first floor.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/student/complaints/{{complaintId}}/follow-up",
              "host": ["{{baseUrl}}"],
              "path": ["student", "complaints", "{{complaintId}}", "follow-up"]
            }
          }
        },
        {
          "name": "Upload Complaint Image",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": {
              "raw": "{{baseUrl}}/student/complaints/{{complaintId}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["student", "complaints", "{{complaintId}}", "images"]
            }
          }
        }
      ]
    },
    {
      "name": "Department Admin Complaints",
      "item": [
        {
          "name": "List Department Complaints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{departmentAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/department-admin/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["department-admin", "complaints"]
            }
          }
        },
        {
          "name": "Assign Worker",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{departmentAdminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workerId\": {{workerId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/department-admin/complaints/{{complaintId}}/worker",
              "host": ["{{baseUrl}}"],
              "path": [
                "department-admin",
                "complaints",
                "{{complaintId}}",
                "worker"
              ]
            }
          }
        },
        {
          "name": "Update Complaint Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{departmentAdminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/department-admin/complaints/{{complaintId}}/status",
              "host": ["{{baseUrl}}"],
              "path": [
                "department-admin",
                "complaints",
                "{{complaintId}}",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "{{notificationId}}", "read"]
            }
          }
        }
      ]
    }
  ]
}
